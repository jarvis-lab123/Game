{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Rechte für das Hauptfenster (gebündelte Startseite und die Voki-Webseite auf GitHub Pages)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "opener:default",
    "allow-set-due-count",
    "allow-stash-migration",
    "allow-take-migration"
  ],
  "remote": {
    "urls": [
      "https://jarvis-lab123.github.io/Game/voki/*"
    ]
  }
}
