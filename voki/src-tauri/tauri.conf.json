{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voki",
  "version": "0.1.0",
  "identifier": "ch.jarvislab.voki",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173/Game/voki/",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voki",
        "width": 1200,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Vokabeltrainer",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
