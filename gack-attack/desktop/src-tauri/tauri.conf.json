{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gack Attack",
  "mainBinaryName": "gack-attack",
  "version": "8.0.0",
  "identifier": "ch.jarvislab.gackattack",
  "build": {
    "beforeBuildCommand": "node prepare.js",
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gack Attack",
        "width": 1600,
        "height": 900,
        "minWidth": 960,
        "minHeight": 560,
        "center": true,
        "maximized": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Tower Defense mit schlecht gelaunten Hoftieren",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "languages": ["German"], "installMode": "currentUser" }
    }
  }
}
